{
  "name": "nova-pos",
  "version": "1.0.0",
  "description": "Nova POS – Fast, offline Point of Sale & Inventory Management desktop application",
  "main": "src/main/main.js",
  "author": "Nova POS Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npx electron-builder",
    "dist": "npx electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "icojs": "^1.0.1",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.novapos.app",
    "productName": "Nova POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
