{
  "name": "nova-pos",
  "version": "1.0.3",
  "description": "Nova POS - Fast, offline Point of Sale & Inventory Management desktop application",
  "main": "src/main/main.js",
  "author": "Basit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npx electron-builder",
    "dist": "npx electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "rebuild": "npx electron-rebuild"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "node-thermal-printer": "^4.6.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "icojs": "^1.0.1",
    "jest": "^30.5.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.novapos.app",
    "productName": "Nova POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
